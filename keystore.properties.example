# Copy to keystore.properties (gitignored) and fill in to sign release builds.
# Paths are resolved relative to the repository root.
# CI can supply the same values as AXIOM_KEYSTORE_FILE, AXIOM_KEYSTORE_PASSWORD,
# AXIOM_KEY_ALIAS and AXIOM_KEY_PASSWORD instead.
storeFile=release.jks
storePassword=
keyAlias=axiom
keyPassword=
