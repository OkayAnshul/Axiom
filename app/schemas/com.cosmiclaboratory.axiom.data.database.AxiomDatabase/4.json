        "contentSyncTriggers": [
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_entry_fts_BEFORE_UPDATE BEFORE UPDATE ON `entries` BEGIN DELETE FROM `entry_fts` WHERE `docid`=OLD.`rowid`; END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_entry_fts_BEFORE_DELETE BEFORE DELETE ON `entries` BEGIN DELETE FROM `entry_fts` WHERE `docid`=OLD.`rowid`; END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_entry_fts_AFTER_UPDATE AFTER UPDATE ON `entries` BEGIN INSERT INTO `entry_fts`(`docid`, `title`, `content`, `promptSnapshot`) VALUES (NEW.`rowid`, NEW.`title`, NEW.`content`, NEW.`promptSnapshot`); END",
          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_entry_fts_AFTER_INSERT AFTER INSERT ON `entries` BEGIN INSERT INTO `entry_fts`(`docid`, `title`, `content`, `promptSnapshot`) VALUES (NEW.`rowid`, NEW.`title`, NEW.`content`, NEW.`promptSnapshot`); END"
        ]
      },
