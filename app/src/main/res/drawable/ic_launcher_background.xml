<!--
  Paper at night — the Night palette's canvas, not pure black.

  A warm near-black is the same surface the app itself uses after dark, so the
  icon and the first screen you see are made of the same material. The faint
  wash above centre is where the ember's light would fall.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF0D0C0B"
        android:pathData="M0,0h108v108h-108z" />

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="48"
                android:gradientRadius="52"
                android:type="radial">
                <item android:offset="0" android:color="#26D99A5B" />
                <item android:offset="1" android:color="#00D99A5B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
