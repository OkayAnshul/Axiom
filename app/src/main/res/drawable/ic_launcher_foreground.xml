<!--
  Ember and paper, which is the whole identity in one mark.

  It replaces path-drawn lettering spelling "Axiom" in white, which was invisible
  against the cream splash background and unreadable at launcher size anyway — a
  wordmark has to survive being 48dp across, and that one did not.

  The paper underneath used to be two flat rules. They read as "text", which is
  true of a great many apps; an open spread reads as "journal", which is true of
  this one. Same claim as before — the ember is the companion, the paper is what
  the two of you keep — stated in a shape that can be recognised without being
  read.

  The spread is drawn as two separate pages with a 2-unit valley between them
  rather than one silhouette with a drawn spine: at 48dp a hairline stroke
  disappears, but a gap that lets the dark ground through survives any downscale.
  The pages carry different alphas for the same reason the rules did — depth
  without a second colour.

  Everything sits between 26 and 82 horizontally and 24 and 84 vertically, inside
  the 66dp adaptive-icon safe zone (21..87 of 108), so no launcher mask can clip
  it. The flame carries a warm vertical gradient because an ember is lit from
  within.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The ember. -->
    <path android:pathData="M54,24C54,24 69,41 69,51.5C69,59.8 62.3,66.5 54,66.5C45.7,66.5 39,59.8 39,51.5C39,41 54,24 54,24Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="24"
                android:endX="54"
                android:endY="66.5"
                android:type="linear">
                <item android:offset="0" android:color="#FFF3BE79" />
                <item android:offset="0.55" android:color="#FFDD9A55" />
                <item android:offset="1" android:color="#FFC4762F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The page it burns on: left leaf. -->
    <path
        android:fillColor="#FFEDE6D9"
        android:fillAlpha="0.82"
        android:pathData="M26,69.5C35,68.1 46,69.7 53,73.5L53,84C46,80.2 35,78.6 26,80Z" />

    <!-- Right leaf, turned away from the light, so it sits back. -->
    <path
        android:fillColor="#FFEDE6D9"
        android:fillAlpha="0.58"
        android:pathData="M82,69.5C73,68.1 62,69.7 55,73.5L55,84C62,80.2 73,78.6 82,80Z" />
</vector>
